{
  "name": "efh-video-studio",
  "version": "1.0.0",
  "private": true,
  "description": "EFH – École Fly Hyani Privé: premium enhancement of the promotional reel (Remotion + FFmpeg)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:hookA": "remotion render src/index.ts EFH-HookA output/EFH_enhanced_hookA.mp4 --codec=h264 --audio-codec=aac --crf=16 --pixel-format=yuv420p",
    "render:hookB": "remotion render src/index.ts EFH-HookB output/EFH_enhanced_hookB.mp4 --codec=h264 --audio-codec=aac --crf=16 --pixel-format=yuv420p",
    "render": "npm run render:hookA && npm run render:hookB"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "@remotion/cli": "4.0.290",
    "@remotion/fonts": "^4.0.290",
    "d3-geo": "3.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.0",
    "@types/react": "18.3.12",
    "@types/topojson-client": "3.1.5",
    "typescript": "5.6.3"
  }
}
