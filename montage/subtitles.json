{
  "_note": "Times are seconds in the ORIGINAL speech clip. Girl = WA0021 (English, subtitles are an Arabic translation). Boy = WA0019 (Arabic, verbatim with light cleanup). Word lists carry highlight start times for karaoke-style captions.",
  "girl": [
    {
      "t0": 1.1,
      "t1": 2.3,
      "text": "المسيرة الخضراء",
      "hl": [
        "المسيرة",
        "الخضراء"
      ]
    },
    {
      "t0": 2.3,
      "t1": 4.95,
      "text": "ليست مجرد احتفالٍ نتذكّره كل عام",
      "hl": []
    },
    {
      "t0": 5.25,
      "t1": 7.2,
      "text": "إنها قصة شعبٍ",
      "hl": [
        "شعبٍ"
      ]
    },
    {
      "t0": 7.2,
      "t1": 10.05,
      "text": "وحّده حبُّه لوطنه",
      "hl": [
        "حبُّه"
      ]
    },
    {
      "t0": 10.3,
      "t1": 12.25,
      "text": "ورمزٌ للوحدة",
      "hl": [
        "للوحدة"
      ]
    },
    {
      "t0": 12.25,
      "t1": 15.3,
      "text": "والتضامن، والفخر بكوننا مغاربة",
      "hl": [
        "مغاربة"
      ]
    },
    {
      "t0": 16.1,
      "t1": 18.2,
      "text": "واليوم، كجيلٍ جديد",
      "hl": [
        "كجيلٍ",
        "جديد"
      ]
    },
    {
      "t0": 18.4,
      "t1": 21.8,
      "text": "مسؤوليتنا أن نحافظ على هذه الروح",
      "hl": [
        "الروح"
      ]
    },
    {
      "t0": 21.8,
      "t1": 24.1,
      "text": "وأن نمثّل وطننا",
      "hl": [
        "وطننا"
      ]
    },
    {
      "t0": 24.1,
      "t1": 26.5,
      "text": "في أحسن صورة أينما حللنا",
      "hl": [
        "أحسن"
      ]
    },
    {
      "t0": 26.9,
      "t1": 30.3,
      "text": "لأنّ حبّ المغرب، أو حبّ وطنك",
      "hl": [
        "المغرب،"
      ]
    },
    {
      "t0": 30.3,
      "t1": 32.4,
      "text": "ليس مجرد كلمات",
      "hl": []
    },
    {
      "t0": 32.4,
      "t1": 36.1,
      "text": "بل هو أيضاً أفعالٌ ومواقف",
      "hl": [
        "أفعالٌ",
        "ومواقف"
      ]
    },
    {
      "t0": 36.3,
      "t1": 38.6,
      "text": "عاش المغرب!",
      "style": "accent"
    }
  ],
